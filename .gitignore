# Any package's build directory, so a new package added later is covered
# without anyone having to remember this file — which is how 1495 build
# artifacts once reached a commit.
.build/
.swiftpm/

# Rev 2 interop demo build products
BASICCompiler/Examples/SwiftInterop/Build/

# Private scratch build dirs, so two agents building this tree at once do not
# contend on one SwiftPM lock (only one SwiftPM may hold a build directory).
.build-claude/
*/.build-claude/
