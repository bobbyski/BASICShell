BASICCompiler/Examples/*/.build
DocumentArchive/.build
DocumentArchive/.swiftpm

# Any package's build directory, so a new package added later is covered
# without anyone having to remember this file — which is how 1495 build
# artifacts once reached a commit.
.build/
.swiftpm/

# Rev 2 interop demo build products
BASICCompiler/Examples/SwiftInterop/Build/

# Private scratch build dirs, so two agents building this tree at once do not
# contend on one SwiftPM lock (only one SwiftPM may hold a build directory).
.build-claude/
*/.build-claude/

# Rev 2 import demo build products
BASICCompiler/Examples/SwiftImport/Program/Build/
BASICCompiler/Examples/SwiftImport/*/.build/

# The private scratch path basicc gives an imported package's own SwiftPM, so
# building a framework for its symbol graph never contends with the build the
# user started in that same package.
.build-basicc/

# The TUIKit exhibit's build products (R5.1)
BASICCompiler/Examples/TUIKitExhibit/Program/Build/
