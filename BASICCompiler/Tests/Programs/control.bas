10 N = 0
20 GOSUB 500
30 N = N + 1
40 IF N < 3 THEN 20
50 ON N GOTO 60, 70, 80
60 PRINT "SIXTY": END
70 PRINT "SEVENTY": END
80 PRINT "EIGHTY"
90 ON N - 2 GOSUB 500, 600
100 SELECT CASE N * 2
110   CASE IS > 10: PRINT "BIG"
120   CASE 6: PRINT "SIX"
130   CASE ELSE: PRINT "ELSE"
140 END SELECT
150 IF N = 3 THEN
160   PRINT "THREE"
170 ELSEIF N = 4 THEN
180   PRINT "FOUR"
190 ELSE
200   PRINT "OTHER"
210 END IF
220 GOTO Done
230 PRINT "SKIPPED"
Done:
240 PRINT "DONE"; N AND 1; N OR 0; -N
250 END
500 PRINT "SUB"; N
510 RETURN
600 PRINT "SUB600"
610 RETURN
