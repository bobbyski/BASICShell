REM Numbers too big for an Int print, and refuse to become one (BBC_ADINS.md A0).
PRINT 9999999999 * 9999999999
PRINT 2 ^ 64
PRINT -(2 ^ 63)
X = 2 ^ 62
PRINT X
10 ON ERROR GOTO 900
20 PRINT LEN(SPACE$(10 ^ 300))
30 PRINT LEFT$("abc", 10 ^ 300)
40 PRINT CHR$(10 ^ 300)
50 END
900 PRINT "TRAPPED ERR="; ERR; "ERL="; ERL
910 RESUME NEXT
