REM GW-BASIC's event traps (BBC_ADINS.md A14): ON TIMER fires every n
REM seconds and is re-armed by RETURN; a handler is never entered again
REM while it runs; STOP remembers a tick and OFF forgets it; GOSUB 0 turns
REM a trap off; STRIG, COM and PEN are armed and never fire. Each handler
REM that must stop counting turns its own trap off, so the output does not
REM depend on how fast the machine is.
10 ON TIMER(0.01) GOSUB 1000
20 TIMER ON: S = TIMER()
30 IF TICKS < 3 AND TIMER() - S < 5 THEN 30
40 PRINT "ticks"; TICKS
50 ON TIMER(0.01) GOSUB 1100
60 TIMER ON: S = TIMER()
70 IF RUNS = 0 AND TIMER() - S < 5 THEN 70
80 PRINT "runs"; RUNS; "deepest"; DEEPEST
90 ON TIMER(0.01) GOSUB 1200
100 TIMER STOP: S = TIMER()
110 IF TIMER() - S < 0.03 THEN 110
120 PRINT "while stopped"; STOPS
130 TIMER ON
140 PRINT "after ON"; STOPS
150 ON TIMER(0.01) GOSUB 1200: TIMER ON
160 ON TIMER(0.01) GOSUB 0
170 S = TIMER()
180 IF TIMER() - S < 0.03 THEN 180
190 PRINT "after GOSUB 0"; STOPS
200 KEY OFF: STRIG ON
210 ON PEN GOSUB 1300: PEN ON
220 ON STRIG(0) GOSUB 1300: STRIG(0) ON
230 ON COM(1) GOSUB 1300: COM(1) ON
240 S = TIMER()
250 IF TIMER() - S < 0.02 THEN 250
260 PRINT "hardware"; HARDWARE
270 END
1000 TICKS = TICKS + 1
1010 IF TICKS = 3 THEN TIMER OFF
1020 RETURN
1100 DEPTH = DEPTH + 1: RUNS = RUNS + 1
1110 IF DEPTH > DEEPEST THEN DEEPEST = DEPTH
1120 W = TIMER()
1130 IF TIMER() - W < 0.03 THEN 1130
1140 TIMER OFF
1150 DEPTH = DEPTH - 1
1160 RETURN
1200 STOPS = STOPS + 1: TIMER OFF: RETURN
1300 HARDWARE = HARDWARE + 1: RETURN
