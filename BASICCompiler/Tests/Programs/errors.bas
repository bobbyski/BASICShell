10 ON ERROR GOTO 900
20 PRINT "START"
30 X = 0
40 Y = 10 / X
50 PRINT "AFTER DIVIDE, Y ="; Y
60 ERROR 42
70 PRINT "AFTER ERROR 42"
80 DIM A(3)
90 A(7) = 1
100 PRINT "AFTER SUBSCRIPT"
110 Z = Broken(5)
120 PRINT "AFTER FUNCTION"
130 ON ERROR GOTO 0
140 PRINT "HANDLER OFF"
150 Q = 1 / X
160 PRINT "NEVER"
170 END
900 PRINT "TRAPPED ERR="; ERR; "ERL="; ERL
910 RESUME NEXT
FUNCTION Broken(N AS DOUBLE) AS DOUBLE
  PRINT "IN BROKEN"
  RETURN N / 0
END FUNCTION
