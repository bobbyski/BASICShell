10 PRINT "HELLO, WORLD"
20 LET A = 40 + 2
30 A$ = "ANSWER: " + STR$(A)
40 PRINT A$; " LEN="; LEN(A$)
50 FOR I = 1 TO 5 STEP 2
60   PRINT I,
70 NEXT I
80 PRINT
90 IF A > 41 THEN PRINT "BIG" ELSE PRINT "SMALL"
100 GOSUB 200
110 SELECT CASE A
120   CASE 1, 2: PRINT "ONE OR TWO"
130   CASE 40 TO 50: PRINT "FORTIES"
140   CASE ELSE: PRINT "OTHER"
150 END SELECT
160 IF A = 42 THEN
170   PRINT "BLOCK IF"; TAB(20); "X"
180 END IF
190 END
200 PRINT "IN SUB"; LEFT$("ABCDEF", 3); MID$("ABCDEF", 2, 2); RIGHT$("ABCDEF", 2)
210 RETURN
